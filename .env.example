# ---------- Telegram ----------
BOT_TOKEN=
# ID администраторов через запятую, например: 111111111,222222222
ADMIN_IDS=
SUPPORT_USERNAME=@your_support
CHANNEL_URL=https://t.me/your_channel

# ---------- ForgetAPI (forgetapi.ru) ----------
# Один ключ на ВСЕ модели сразу (Claude/GPT/Gemini/nano-banana и др.) — единый
# OpenAI-совместимый эндпоинт. Можно оставить пустым и ввести ключ прямо в боте:
# Админ-панель -> Настройки ForgetAPI
FORGETAPI_KEY=
# Базовый URL — обычно не нужно менять
FORGETAPI_BASE_URL=https://api.forgetapi.ru/v1

# ---------- Platega ----------
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_API_VERSION=v1
# 2=СБП, 10=карты RUB, 11=карты, 12=межд. карты, 13=крипто
PLATEGA_ACTIVE_METHODS=2,10,11
PLATEGA_RETURN_URL=https://t.me/your_bot
PLATEGA_FAILED_URL=https://t.me/your_bot
PLATEGA_WEBHOOK_PATH=/platega-webhook

# ---------- Webhook сервер (принимает колбэк от Platega) ----------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Публичный адрес, на который смотрит Platega, например https://hooks.example.com
PUBLIC_BASE_URL=

# ---------- Бизнес-правила ----------
MIN_TOPUP_RUB=10
REFERRAL_FREE_REQUESTS=7
REFERRAL_COMMISSION_PERCENT=5
SIGNUP_BONUS_TOKENS=5000
DB_PATH=./bot.db

# ссылки на документы (можно оставить пустыми — бот тогда скажет "документ не добавлен")
USER_AGREEMENT_URL=
PRIVACY_POLICY_URL=

# ---------- Распознавание голосовых (бесплатно, локально, через faster-whisper) ----------
# Размер модели: tiny / base / small / medium / large-v3.
# Чем больше — тем точнее, но тем больше RAM/CPU и медленнее. "small" — хороший баланс для CPU.
WHISPER_MODEL_SIZE=small
# "cpu" или "cuda" (если на сервере есть GPU)
WHISPER_DEVICE=cpu
# "int8" — быстро и легко на CPU; для GPU обычно ставят "float16"
WHISPER_COMPUTE_TYPE=int8
